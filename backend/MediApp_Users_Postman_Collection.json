{
    "info": {
        "name": "MediApp - Users Module (Valid Import - Updated 2)",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
        "description": "Users APIs: signup, confirm email, signin, 2FA OTP signin, refresh token, resend confirm, me/profile, update profile, request/check OTP, forget/reset password, email change, toggle 2FA, logout."
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:8000"
        },
        {
            "key": "prefixUser",
            "value": "Bearer"
        },
        {
            "key": "accessToken",
            "value": ""
        },
        {
            "key": "refreshToken",
            "value": ""
        },
        {
            "key": "challengeToken",
            "value": ""
        },
        {
            "key": "resetToken",
            "value": ""
        },
        {
            "key": "userId",
            "value": ""
        },
        {
            "key": "confirmEmailToken",
            "value": ""
        },
        {
            "key": "confirmEmailChangeToken",
            "value": ""
        }
    ],
    "item": [
        {
            "name": "01 - Health",
            "request": {
                "method": "GET",
                "url": "{{baseUrl}}/health"
            }
        },
        {
            "name": "02 - Signup (patient)",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"type\": \"patient\",\n  \"firstName\": \"Ahmed\",\n  \"lastName\": \"Abu Seada\",\n  \"email\": \"ahmedabuseada22@gmail.com\",\n  \"password\": \"116574Mm@@\",\n  \"confirmPassword\": \"116574Mm@@\",\n  \"phone\": \"01012345678\",\n  \"DOB\": \"2000-01-01\",\n  \"age\": 26,\n  \"gender\": \"male\",\n  \"twoFA\": false\n}"
                },
                "url": "{{baseUrl}}/users/signup"
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "let json = {};",
                            "try { json = pm.response.json(); } catch (e) {}",
                            "if (json?.user?.id) pm.collectionVariables.set('userId', json.user.id);",
                            "if (json?.accessToken) pm.collectionVariables.set('accessToken', json.accessToken);",
                            "if (json?.refreshToken) pm.collectionVariables.set('refreshToken', json.refreshToken);"
                        ]
                    }
                }
            ]
        },
        {
            "name": "03 - Confirm Email (paste token into confirmEmailToken)",
            "request": {
                "method": "GET",
                "url": "{{baseUrl}}/users/confirmEmail/{{confirmEmailToken}}"
            }
        },
        {
            "name": "04 - Signin (normal or returns challengeToken if 2FA)",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"email\": \"ahmedabuseada22@gmail.com\",\n  \"password\": \"116574Mm@@\"\n}"
                },
                "url": "{{baseUrl}}/users/signin"
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "let json = {};",
                            "try { json = pm.response.json(); } catch (e) {}",
                            "if (json?.accessToken) pm.collectionVariables.set('accessToken', json.accessToken);",
                            "if (json?.refreshToken) pm.collectionVariables.set('refreshToken', json.refreshToken);",
                            "if (json?.challengeToken) pm.collectionVariables.set('challengeToken', json.challengeToken);",
                            "if (json?.user?.id) pm.collectionVariables.set('userId', json.user.id);"
                        ]
                    }
                }
            ]
        },
        {
            "name": "05 - Signin with OTP (2FA only) - replace otp",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"challengeToken\": \"{{challengeToken}}\",\n  \"otp\": \"123456\"\n}"
                },
                "url": "{{baseUrl}}/users/signin/otp"
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "let json = {};",
                            "try { json = pm.response.json(); } catch (e) {}",
                            "if (json?.accessToken) pm.collectionVariables.set('accessToken', json.accessToken);",
                            "if (json?.refreshToken) pm.collectionVariables.set('refreshToken', json.refreshToken);"
                        ]
                    }
                }
            ]
        },
        {
            "name": "06 - Refresh Token",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "{{prefixUser}} {{refreshToken}}"
                    }
                ],
                "url": "{{baseUrl}}/users/refreshToken"
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "let json = {};",
                            "try { json = pm.response.json(); } catch (e) {}",
                            "if (json?.accessToken) pm.collectionVariables.set('accessToken', json.accessToken);",
                            "if (json?.refreshToken) pm.collectionVariables.set('refreshToken', json.refreshToken);"
                        ]
                    }
                }
            ]
        },
        {
            "name": "07 - Resend Confirm Email (Protected)",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "{{prefixUser}} {{accessToken}}"
                    }
                ],
                "url": "{{baseUrl}}/users/resendConfirmEmail"
            }
        },
        {
            "name": "08 - Me (Protected)",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "{{prefixUser}} {{accessToken}}"
                    }
                ],
                "url": "{{baseUrl}}/users/me"
            }
        },
        {
            "name": "09 - Public Profile By ID",
            "request": {
                "method": "GET",
                "url": "{{baseUrl}}/users/profile/{{userId}}"
            }
        },
        {
            "name": "10 - Update Profile (Protected)",
            "request": {
                "method": "PATCH",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "{{prefixUser}} {{accessToken}}"
                    },
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"phone\": \"01098765432\"\n}"
                },
                "url": "{{baseUrl}}/users/updateProfile"
            }
        },
        {
            "name": "11 - Request OTP (Public - Generic)",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"email\": \"ahmedabuseada22@gmail.com\"\n}"
                },
                "url": "{{baseUrl}}/users/requestOTP"
            }
        },
        {
            "name": "12 - Check OTP (Public - Generic)",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"email\": \"ahmedabuseada22@gmail.com\",\n  \"otp\": \"123456\"\n}"
                },
                "url": "{{baseUrl}}/users/checkOTP"
            }
        },
        {
            "name": "13 - Forget Password - Request OTP",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"email\": \"ahmedabuseada22@gmail.com\"\n}"
                },
                "url": "{{baseUrl}}/users/forgetPassword"
            }
        },
        {
            "name": "14 - Forget Password - Verify OTP",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"email\": \"ahmedabuseada22@gmail.com\",\n  \"otp\": \"123456\"\n}"
                },
                "url": "{{baseUrl}}/users/forgetPassword/verify"
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "let json = {};",
                            "try { json = pm.response.json(); } catch (e) {}",
                            "if (json?.resetToken) pm.collectionVariables.set('resetToken', json.resetToken);"
                        ]
                    }
                }
            ]
        },
        {
            "name": "15 - Reset Password (Public with Token)",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"resetToken\": \"{{resetToken}}\",\n  \"newPassword\": \"New@123456\",\n  \"confirmPassword\": \"New@123456\"\n}"
                },
                "url": "{{baseUrl}}/users/resetPassword"
            }
        },
        {
            "name": "16 - Change Password (Protected)",
            "request": {
                "method": "PATCH",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "{{prefixUser}} {{accessToken}}"
                    },
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"oldPassword\": \"116574Mm@@\",\n  \"newPassword\": \"New@123456\",\n  \"confirmPassword\": \"New@123456\"\n}"
                },
                "url": "{{baseUrl}}/users/changePassword"
            }
        },
        {
            "name": "17 - Toggle 2FA (Protected)",
            "request": {
                "method": "PATCH",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "{{prefixUser}} {{accessToken}}"
                    },
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"enabled\": true\n}"
                },
                "url": "{{baseUrl}}/users/2fa"
            }
        },
        {
            "name": "18 - Request Email Change (Protected)",
            "request": {
                "method": "PATCH",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "{{prefixUser}} {{accessToken}}"
                    },
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"newEmail\": \"ahmed_patient_1_new@test.com\"\n}"
                },
                "url": "{{baseUrl}}/users/email/change"
            }
        },
        {
            "name": "19 - Cancel Email Change (Protected)",
            "request": {
                "method": "PATCH",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "{{prefixUser}} {{accessToken}}"
                    }
                ],
                "url": "{{baseUrl}}/users/email/cancel"
            }
        },
        {
            "name": "20 - Confirm Email Change (paste token into confirmEmailChangeToken)",
            "request": {
                "method": "GET",
                "url": "{{baseUrl}}/users/confirmEmailChange/{{confirmEmailChangeToken}}"
            }
        },
        {
            "name": "21 - Logout (Protected)",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "{{prefixUser}} {{accessToken}}"
                    }
                ],
                "url": "{{baseUrl}}/users/logout"
            }
        }
    ]
}