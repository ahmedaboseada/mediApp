  "item": [
    {
      "name": "Profile Completion",
      "item": [
        {
          "name": "Complete Profile (One Step)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "bearer {{ACCESS_TOKEN}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "avatar",
                  "type": "file",
                  "src": []
                },
                {
                  "key": "phone",
                  "value": "+1234567890",
                  "type": "text"
                },
                {
                  "key": "yearOfBirth",
                  "value": "1990",
                  "type": "text"
                },
                {
                  "key": "gender",
                  "value": "male",
                  "type": "text"
                },
                {
                  "key": "chronicConditions[0]",
                  "value": "Hypertension",
                  "type": "text"
                },
                {
                  "key": "longTermMedication[0]",
                  "value": "Aspirin",
                  "type": "text"
                },
                {
                  "key": "longTermMedication[1]",
                  "value": "Ibuprofen",
                  "type": "text"
                },
                {
                  "key": "allergies[0]",
                  "value": "Penicillin",
                  "type": "text"
                },
                {
                  "key": "reactionToMedication",
                  "value": "true",
                  "type": "text"
                },
                {
                  "key": "allergyAlerts",
                  "value": "true",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{BASE_URL}}/patients/complete",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "patients",
                "complete"
              ]
            }
          }
        },
