    {
      "name": "Caregiver Logic",
      "item": [
        {
          "name": "Set Caregiving Option",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "bearer {{ACCESS_TOKEN}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"caregivingOption\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{BASE_URL}}/patients/caregiver/option",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "patients",
                "caregiver",
                "option"
              ]
            }
          }
        },
        {
          "name": "Send Caregiver Request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "bearer {{ACCESS_TOKEN}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"caregiverEmail\": \"caregiver@example.com\",\n    \"relationship\": \"parent\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{BASE_URL}}/patients/caregiver/request",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "patients",
                "caregiver",
                "request"
              ]
            }
          }
        },
        {
          "name": "List Caregiver Requests (Inbox)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "bearer {{CAREGIVER_ACCESS_TOKEN}}"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/patients/caregiver/requests",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "patients",
                "caregiver",
                "requests"
              ]
            }
          }
        },
        {
          "name": "Accept Caregiver Request",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "bearer {{CAREGIVER_ACCESS_TOKEN}}"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/patients/caregiver/requests/:requestId/accept",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "patients",
                "caregiver",
                "requests",
                ":requestId",
                "accept"
              ],
              "variable": [
                {
                  "key": "requestId",
                  "value": "65b4c43...",
                  "description": "MongoDB Request ID fetched from inbox"
                }
              ]
            }
          }
        },
        {
          "name": "Reject Caregiver Request",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "bearer {{CAREGIVER_ACCESS_TOKEN}}"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/patients/caregiver/requests/:requestId/reject",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "patients",
                "caregiver",
                "requests",
                ":requestId",
                "reject"
              ],
              "variable": [
                {
                  "key": "requestId",
                  "value": "65b4c43...",
                  "description": "MongoDB Request ID fetched from inbox"
                }
              ]
            }
          }
        }
      ]
    },
